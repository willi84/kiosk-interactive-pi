KIOSK_HOSTNAME="<HOSTNAME>"

# Kontext: Google Slides Präsentation (großer Monitor)
CONTEXT_SLIDES_URL="https://docs.google.com/presentation/d/1qXXRuxEdrp3nGutWSS2N0uWYt8sRPmL24-GsqXWlJDM/present?loop=true&delayms=10000"

# Kontext: Website (kleiner Monitor / Touch)
CONTEXT_WEBSITE_URL="https://pendler-alarm.de/"

# Optional: explizite Fenstergeometrie pro Kontext.
# Falls nicht gesetzt, erkennt setup-kiosk.sh die Monitor-Geometrie über xrandr.
# Bei zwei Monitoren auf demselben DISPLAY: slides → größerer, website → kleinerer Monitor.
# Limitation: this is a size-based heuristic and may be wrong if touch is on the larger screen
# or when xrandr does not report monitor geometry correctly.
# SLIDES_DISPLAY=":0"
# SLIDES_WINDOW_POSITION="0,0"
# SLIDES_WINDOW_SIZE="1920,1080"
# WEBSITE_DISPLAY=":0"
# WEBSITE_WINDOW_POSITION="1920,0"
# WEBSITE_WINDOW_SIZE="1024,600"

# Rückwärtskompatibilität: SCREEN1_URL / SCREEN2_URL werden noch unterstützt,
# wenn CONTEXT_SLIDES_URL / CONTEXT_WEBSITE_URL nicht gesetzt sind.

WIFI_SSID="<SSID>"
WIFI_PASSWORD="<PASSWORD>"
WIFI_HIDDEN="false"
