KIOSK_HOSTNAME="<HOSTNAME>"

SCREEN1_URL="https://docs.google.com/presentation/d/1qXXRuxEdrp3nGutWSS2N0uWYt8sRPmL24-GsqXWlJDM/present?loop=true&delayms=10000"
SCREEN2_URL="https://pendler-alarm.de/"

# Optional: set explicit per-screen geometry for mixed-resolution layouts.
# If left unset, setup-kiosk.sh tries to detect the current xrandr monitor layout.
# Bei zwei Monitoren auf demselben DISPLAY wird screen1 automatisch dem größeren,
# screen2 dem kleineren Monitor zugeordnet (praktisch für "kleiner Screen = Touch").
# SCREEN1_DISPLAY=":0"
# SCREEN1_WINDOW_POSITION="0,0"
# SCREEN1_WINDOW_SIZE="1920,1080"
# SCREEN2_DISPLAY=":0"
# SCREEN2_WINDOW_POSITION="1920,0"
# SCREEN2_WINDOW_SIZE="1024,600"

WIFI_SSID="<SSID>"
WIFI_PASSWORD="<PASSWORD>"
WIFI_HIDDEN="false"
